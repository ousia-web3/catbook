cat:CatbookOntology a owl:Ontology ;
    dcterms:created "2026-06-08T06:03:47.104619+00:00"^^xsd:dateTime ;
    dcterms:description "초보자 질문, 고양이 신호, 욕구/상태, 환경, 건강 관찰, 집사 행동, 책 챕터, 유튜브 콘텐츠 근거를 연결한 탐색형 온톨로지" ;
    dcterms:source "catbook/research/cat_ontology_graph.json" ;
    dcterms:title "냥톨로지" ;
    owl:versionInfo "2026-06-05.2" .

cat:beginnerGuide a owl:DatatypeProperty ;
    rdfs:label "초보자 안내" .

cat:classId a owl:DatatypeProperty ;
    rdfs:label "원본 클래스 ID" .

cat:color a owl:DatatypeProperty ;
    rdfs:label "시각화 색상" .

cat:confidence a owl:DatatypeProperty ;
    rdfs:label "관계 신뢰 수준" .

cat:durationMinutes a owl:DatatypeProperty ;
    rdfs:label "길이(분)" .

cat:evidenceCount a owl:DatatypeProperty ;
    rdfs:label "근거 콘텐츠 수" .

cat:firstCheck a owl:DatatypeProperty ;
    rdfs:label "첫 확인 질문" .

cat:isMedicalSensitive a owl:DatatypeProperty ;
    rdfs:label "의료 민감 여부" .

cat:keyword a owl:DatatypeProperty ;
    rdfs:label "키워드" .

cat:mapsToPart a owl:ObjectProperty ;
    rdfs:label "콘텐츠가 책 파트 후보와 연결됨" ;
    rdfs:subPropertyOf cat:semanticLink .

cat:matchHit a owl:DatatypeProperty ;
    rdfs:label "매칭 히트" .

cat:mediaFamily a owl:DatatypeProperty ;
    rdfs:label "콘텐츠 유형" .

cat:nodeId a owl:DatatypeProperty ;
    rdfs:label "원본 노드 ID" .

cat:nonDiagnosticOnly a owl:DatatypeProperty ;
    rdfs:label "진단/처방 금지" .

cat:observePoint a owl:DatatypeProperty ;
    rdfs:label "관찰 포인트" .

cat:question a owl:DatatypeProperty ;
    rdfs:label "상황 질문" .

cat:safety a owl:DatatypeProperty ;
    rdfs:label "안전 주석" .

cat:score a owl:DatatypeProperty ;
    rdfs:label "매칭 점수" .

cat:showsSignal a owl:ObjectProperty ;
    rdfs:label "콘텐츠가 신호를 보여줌" ;
    rdfs:subPropertyOf cat:semanticLink .

cat:sourceId a owl:DatatypeProperty ;
    rdfs:label "원본 콘텐츠 ID" .

cat:summary a owl:DatatypeProperty ;
    rdfs:label "요약" .

cat:thumbnailUrl a owl:DatatypeProperty ;
    rdfs:label "썸네일 URL" .

cat:url a owl:AnnotationProperty ;
    rdfs:label "대표 URL" .

cat:viewCount a owl:DatatypeProperty ;
    rdfs:label "조회 수" .

cat:watchUrl a owl:DatatypeProperty ;
    rdfs:label "시청 URL" .

